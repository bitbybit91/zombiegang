# ZombieGang CLI Environment Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Configuration (Optional but recommended)
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tor Configuration (Optional but recommended for anonymity)
# Default Tor SOCKS proxy settings
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050

# Python Configuration
# Set to True for debug logging
DEBUG=False
